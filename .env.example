# Server
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# Scanner
DEFAULT_MAX_PAGES=8
MAX_ALLOWED_PAGES=20
MAX_MOBILE_PAGES=3
PAGE_TIMEOUT_MS=45000
MAX_CANDIDATE_URLS=250
HEADLESS=true

# Ollama (cloud only - no local daemon)
# The app calls Ollama's hosted API directly. OLLAMA_HOST must be a bare
# origin: the client appends /api/chat itself (server/ai/ollama.ts).
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=600000
OLLAMA_THINKING=high
OLLAMA_SEND_SCREENSHOTS=true
AI_ENABLED=true

# Keep false unless you are intentionally testing local/private targets.
# Enabling this weakens SSRF protection and is not recommended.
ALLOW_PRIVATE_NETWORKS=false

# Vision coverage: each page is sliced into legible top-to-bottom bands.
SCREENSHOT_BAND_HEIGHT=1400
MAX_BANDS_PER_PAGE=30
MAX_AI_IMAGES=14

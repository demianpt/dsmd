# Server
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# Scanner
DEFAULT_MAX_PAGES=8
MAX_ALLOWED_PAGES=20
MAX_MOBILE_PAGES=3
PAGE_TIMEOUT_MS=45000
MAX_CANDIDATE_URLS=250
HEADLESS=true

# Ollama
# Recommended cloud model for this project. Run `ollama signin` first, then
# `ollama pull glm-5.3-flash:cloud`. The app calls your local Ollama daemon.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=glm-5.3-flash:cloud
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=600000
OLLAMA_THINKING=high
OLLAMA_SEND_SCREENSHOTS=true
AI_ENABLED=true

# Keep false unless you are intentionally testing local/private targets.
# Enabling this weakens SSRF protection and is not recommended.
ALLOW_PRIVATE_NETWORKS=false
